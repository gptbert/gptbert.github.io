---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/posts/' | absolute_url }}</loc></url>
  <url><loc>{{ '/books/' | absolute_url }}</loc></url>
  <url><loc>{{ '/projects/' | absolute_url }}</loc></url>
  <url><loc>{{ '/about/' | absolute_url }}</loc></url>
  <url><loc>{{ '/en/' | absolute_url }}</loc></url>
  <url><loc>{{ '/en/posts/' | absolute_url }}</loc></url>
  <url><loc>{{ '/en/books/' | absolute_url }}</loc></url>
  <url><loc>{{ '/en/projects/' | absolute_url }}</loc></url>
  <url><loc>{{ '/en/about/' | absolute_url }}</loc></url>
  <url><loc>{{ '/privacy.html' | absolute_url }}</loc></url>
  <url><loc>{{ '/support.html' | absolute_url }}</loc></url>
  <url><loc>{{ '/en/privacy.html' | absolute_url }}</loc></url>
  <url><loc>{{ '/en/support.html' | absolute_url }}</loc></url>
  {% for post in site.posts %}<url><loc>{{ post.url | absolute_url }}</loc><lastmod>{{ post.date | date: '%Y-%m-%d' }}</lastmod></url>{% endfor %}
</urlset>
